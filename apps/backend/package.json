{
    "name": "backend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "format": "prettier --write .",
        "lint": "eslint src",
        "test": "vitest run --coverage.enabled=true --coverage.reporter=lcov",
        "api:lint": "redocly lint ../../docs/api/openapi.yaml",
        "api:preview": "pnpm exec redocly build-docs ../../docs/api/openapi.yaml -o public/docs/index.html"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@redocly/cli": "^2.32.2",
        "@vitest/coverage-v8": "^4.1.7",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.12",
        "vitest": "^4.1.7"
    }
}
