{
    "name": "backend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "sops -d config/development.enc.env > config/development.env && sops -d --output-type dotenv config/db.enc.yaml > config/db.env && nodemon -L --exec tsx server.ts",
        "local": "nodemon -L --exec tsx server.ts",
        "script:eval": "tsx src/utils/gameUtils.ts",
        "build": "tsc",
        "preview": "vite preview",
        "format": "prettier --write .",
        "lint": "eslint src",
        "test": "vitest run --coverage.enabled=true --coverage.reporter=lcov",
        "test:mutation": "stryker run",
        "api:lint": "redocly lint api/openapi.yaml",
        "api:preview": "pnpm exec redocly build-docs api/openapi.yaml -o ../frontend/public/docs/api-docs.html --theme.openapi.hideDownloadButton"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@redocly/cli": "^2.51.2",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/bcryptjs": "^3.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.4.1",
        "@types/pg": "^8.23.1",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.6",
        "tsx": "^4.23.13",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "colors": "^1.4.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-openapi-validator": "^5.6.2",
        "express-session": "^1.19.0",
        "google-auth-library": "^11.0.2",
        "install": "^0.13.0",
        "morgan": "^1.12.0",
        "pg": "^8.23.0",
        "prom-client": "^15.1.3",
        "zod": "^4.5.4"
    }
}
