{
    "name": "backend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "nodemon -L --exec tsx server.ts",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "format": "prettier --write .",
        "lint": "eslint src",
        "test": "vitest run --coverage.enabled=true --coverage.reporter=lcov",
        "api:lint": "redocly lint ../../docs/api/openapi.yaml",
        "api:preview": "pnpm exec redocly build-docs ../../docs/api/openapi.yaml -o public/docs/index.html"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@redocly/cli": "^2.34.0",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.0.0",
        "@vitest/coverage-v8": "^4.1.9",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.4",
        "tsx": "^4.22.4",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.61.1",
        "vite": "^8.0.16",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "colors": "^1.4.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "morgan": "^1.11.0"
    }
}
