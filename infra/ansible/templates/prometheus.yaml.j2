global:
  scrape_interval: 15s
  scrape_timeout: 10s
  evaluation_interval: 15s

  external_labels:
    environment: "{{ environment_name | default('showcase') }}"
    prometheus_host: "{{ inventory_hostname }}"

rule_files:
  - /etc/prometheus/rules/*.yml
  - /etc/prometheus/rules/*.yaml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: node-backend
    static_configs:
      - targets:
          - {{ hostvars[groups['role_app'][0]]['private_ip_address'] }}:5000
  
  - job_name: node
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/node.yml
